<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Profile & Security"/><c:set var="pageHeading" value="Your profile, your controls."/><c:set var="pageEyebrow" value="Account settings"/><c:set var="pageKey" value="profile"/><jsp:include page="includes/header.jsp"/>
<div class="split-layout"><section class="glass-panel content-card"><div class="profile-hero"><div class="avatar xl">${user.fullName.substring(0,1)}</div><div><span class="eyebrow">Customer profile</span><h2>${user.fullName}</h2><p class="muted">@${user.username} · ${user.role}</p></div></div><form class="bank-form" method="post" action="${pageContext.request.contextPath}/profile"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="profile"><label>Full name<input name="fullName" value="${user.fullName}" required></label><label>Email<input type="email" name="email" value="${user.email}" required></label><label>Phone<input name="phone" value="${user.phone}" required maxlength="10"></label><button class="primary-button full" type="submit">Save profile <span>→</span></button></form></section><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Security</span><h2>Change password</h2><p class="muted">Passwords are hashed using PBKDF2 with a per-password salt.</p></div></div><form class="bank-form" method="post" action="${pageContext.request.contextPath}/profile"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="password"><label>Current password<input type="password" name="currentPassword" required></label><label>New password<input type="password" name="newPassword" minlength="8" required></label><button class="secondary-button full" type="submit">Change password</button></form><div class="security-callout"><span>●</span><div><strong>Session timeout: 30 minutes</strong><p>Sign out on shared devices and never use real banking credentials in this academic project.</p></div></div></section></div><jsp:include page="includes/footer.jsp"/>
