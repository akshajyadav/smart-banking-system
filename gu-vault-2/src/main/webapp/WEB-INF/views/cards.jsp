<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Cards"/><c:set var="pageHeading" value="Your cards, under control."/><c:set var="pageEyebrow" value="Card management"/><c:set var="pageKey" value="cards"/><jsp:include page="includes/header.jsp"/>
<div class="card-grid"><c:forEach var="card" items="${cards}"><article class="bank-card glass-panel"><div class="bank-card-head"><span class="bank-card-label">GU-Vault Debit</span><strong>${card.network}</strong></div><div class="chip">▦</div><div class="card-number">${card.maskedCardNumber}</div><div class="bank-card-foot"><div><small>Cardholder</small><strong>${card.cardholderName}</strong></div><div><small>Expires</small><strong>${card.expiryDate}</strong></div><span class="pill ${card.status == 'ACTIVE' ? 'success' : 'warning'}">${card.status}</span></div></article><div class="card-controls glass-panel content-card"><div><span class="section-kicker">Controls</span><h2>Card settings</h2></div><div class="control-row"><div><strong>Card status</strong><small>Freeze temporarily if you suspect unusual activity.</small></div><form method="post" action="${pageContext.request.contextPath}/cards"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="toggle"><input type="hidden" name="cardId" value="${card.id}"><button class="secondary-button" type="submit">${card.status == 'ACTIVE' ? 'Freeze card' : 'Unfreeze card'}</button></form></div><div class="control-row"><div><strong>Change PIN</strong><small>For the academic simulation only.</small></div><form class="inline-form" method="post" action="${pageContext.request.contextPath}/cards"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="pin"><input type="hidden" name="cardId" value="${card.id}"><input type="password" name="pin" maxlength="4" minlength="4" inputmode="numeric" placeholder="••••" required><button class="secondary-button" type="submit">Update PIN</button></form></div></div></c:forEach><c:if test="${empty cards}"><div class="empty-state">No cards linked to this profile.</div></c:if></div><jsp:include page="includes/footer.jsp"/>
