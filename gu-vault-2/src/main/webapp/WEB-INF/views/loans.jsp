<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Loans"/><c:set var="pageHeading" value="Borrow with clarity."/><c:set var="pageEyebrow" value="Loans & EMI"/><c:set var="pageKey" value="loans"/><jsp:include page="includes/header.jsp"/>
<div class="split-layout"><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Loan planning</span><h2>EMI calculator & application</h2><p class="muted">Rate and eligibility values are illustrative for the academic simulation.</p></div></div><form class="bank-form" method="post" action="${pageContext.request.contextPath}/loans"><input type="hidden" name="csrfToken" value="${csrfToken}"><label>Loan type<select name="loanType"><option>Education Loan</option><option>Personal Loan</option><option>Home Loan</option></select></label><label>Principal<input type="number" name="principal" min="10000" step="1000" value="250000" required></label><label>Annual interest rate (%)<input type="number" name="rate" min="1" max="30" step="0.01" value="9.25" required></label><label>Tenure (months)<input type="number" name="months" min="6" max="84" value="36" required></label><div class="button-row"><button class="secondary-button" name="action" value="calculate" type="submit">Calculate EMI</button><button class="primary-button" name="action" value="apply" type="submit">Submit application <span>→</span></button></div><c:if test="${not empty sessionScope.emi}"><div class="result-strip"><span>Estimated EMI</span><strong>₹${sessionScope.emi}</strong><a href="${pageContext.request.contextPath}/loans">clear</a></div><c:remove var="emi" scope="session"/></c:if></form></section><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Existing applications</span><h2>Your loans</h2></div></div><div class="loan-list"><c:forEach var="loan" items="${loans}"><div class="loan-row"><div class="quick-icon">◇</div><div class="grow"><strong>${loan.loanType}</strong><small>₹${loan.principal} · ${loan.tenureMonths} months · ${loan.interestRate}%</small></div><div class="loan-right"><span class="pill ${loan.status == 'ACTIVE' ? 'success' : 'warning'}">${loan.status}</span><strong>₹${loan.emi}/mo</strong></div></div></c:forEach><c:if test="${empty loans}"><div class="empty-state">No loan applications yet.</div></c:if></div></section></div><jsp:include page="includes/footer.jsp"/>
