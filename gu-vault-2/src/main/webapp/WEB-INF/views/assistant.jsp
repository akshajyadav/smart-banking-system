<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Smart Assistant"/><c:set var="pageHeading" value="Understand your money."/><c:set var="pageEyebrow" value="Local financial insights"/><c:set var="pageKey" value="assistant"/><jsp:include page="includes/header.jsp"/>
<div class="content-grid"><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Smart Assistant</span><h2>Personalized demo insights</h2><p class="muted">These insights are calculated locally from your GU-Vault transaction history. No external AI service is called.</p></div></div><div class="assistant-list"><c:forEach var="entry" items="${insights}"><div class="assistant-card big"><div class="assistant-orb">✦</div><div><strong>${entry.key}</strong><p>${entry.value}</p></div></div></c:forEach></div></section><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Spending mix</span><h2>Last 30 days</h2></div></div><c:forEach var="entry" items="${spending}"><div class="meter-row"><div><strong>${entry.key}</strong><span>₹${entry.value}</span></div><div class="meter"><span style="width:${entry.value.doubleValue()/account.balance.doubleValue()*100}%"></span></div></div></c:forEach><c:if test="${empty spending}"><div class="empty-state">Not enough debit data yet.</div></c:if></section></div><jsp:include page="includes/footer.jsp"/>
