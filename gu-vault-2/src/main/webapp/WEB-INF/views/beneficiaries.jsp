<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="pageTitle" value="Beneficiaries"/><c:set var="pageHeading" value="Trusted recipients."/><c:set var="pageEyebrow" value="Manage recipients"/><c:set var="pageKey" value="beneficiaries"/><jsp:include page="includes/header.jsp"/>
<div class="split-layout"><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Add beneficiary</span><h2>Save a new recipient</h2><p class="muted">Only recipients you create can be selected for GU-Vault transfers.</p></div></div><form class="bank-form" method="post" action="${pageContext.request.contextPath}/beneficiaries"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="add"><label>Beneficiary name<input name="beneficiaryName" required maxlength="100" placeholder="Full name"></label><label>Account number<input name="accountNumber" inputmode="numeric" required maxlength="18" placeholder="10–18 digits"></label><label>IFSC code<input name="ifscCode" required maxlength="11" placeholder="GUVB0001001"></label><label>Nickname <span class="muted">optional</span><input name="nickname" maxlength="50" placeholder="e.g. Riya"></label><button class="primary-button full" type="submit">Save beneficiary <span>→</span></button></form></section><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Your list</span><h2>Saved beneficiaries</h2></div><span class="pill">${fn:length(beneficiaries)} saved</span></div><div class="beneficiary-list"><c:forEach var="b" items="${beneficiaries}"><div class="beneficiary-row"><div class="avatar">${b.beneficiaryName.substring(0,1)}</div><div class="grow"><strong>${b.displayName}</strong><small>${b.accountNumber} · ${b.ifscCode}</small></div><form method="post" action="${pageContext.request.contextPath}/beneficiaries" data-confirm="Remove this beneficiary?"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${b.id}"><button class="danger-button" type="submit">Remove</button></form></div></c:forEach><c:if test="${empty beneficiaries}"><div class="empty-state">Your beneficiary list is empty.</div></c:if></div></section></div><jsp:include page="includes/footer.jsp"/>
