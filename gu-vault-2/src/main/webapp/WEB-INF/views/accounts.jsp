<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Accounts"/><c:set var="pageHeading" value="Your accounts, clearly presented."/><c:set var="pageEyebrow" value="Account centre"/><c:set var="pageKey" value="accounts"/><jsp:include page="includes/header.jsp"/>
<div class="account-card-grid"><c:forEach var="account" items="${accounts}"><section class="glass-panel content-card account-card"><div class="section-head"><div><span class="section-kicker">${account.accountType}</span><h2>${account.maskedAccountNumber}</h2></div><span class="pill success">${account.status}</span></div><div class="big-balance">₹${account.balance}</div><div class="account-detail-grid"><div><span>IFSC</span><strong>${account.ifscCode}</strong></div><div><span>Currency</span><strong>${account.currency}</strong></div><div><span>Account number</span><strong>${account.accountNumber}</strong></div><div><span>Type</span><strong>${account.accountType}</strong></div></div><div class="button-row"><a class="secondary-button" href="${pageContext.request.contextPath}/transactions">View transactions</a><a class="primary-button" href="${pageContext.request.contextPath}/transfer">Send money →</a></div></section></c:forEach></div><jsp:include page="includes/footer.jsp"/>
