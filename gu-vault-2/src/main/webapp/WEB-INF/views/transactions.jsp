<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Transactions"/><c:set var="pageHeading" value="Your money trail."/><c:set var="pageEyebrow" value="Account activity"/><c:set var="pageKey" value="transactions"/><jsp:include page="includes/header.jsp"/>
<section class="glass-panel content-card"><form class="filter-bar" method="get" action="${pageContext.request.contextPath}/transactions"><div><label>Search<input name="q" value="${param.q}" placeholder="Merchant, reference or category"></label></div><div><label>Type<select name="type"><option value="ALL" ${empty param.type || param.type == 'ALL' ? 'selected' : ''}>All</option><option value="TRANSFER" ${param.type == 'TRANSFER' ? 'selected' : ''}>Transfer</option><option value="PAYMENT" ${param.type == 'PAYMENT' ? 'selected' : ''}>Payment</option><option value="CREDIT" ${param.type == 'CREDIT' ? 'selected' : ''}>Credit</option></select></label></div><div><label>From<input type="date" name="from" value="${param.from}"></label></div><div><label>To<input type="date" name="to" value="${param.to}"></label></div><button class="secondary-button filter-submit" type="submit">Apply filters</button><a class="secondary-button" href="${pageContext.request.contextPath}/statement">Download CSV</a></form>
<div class="table-wrap"><table><thead><tr><th>Activity</th><th>Reference</th><th>Type</th><th>Amount</th><th>Status</th><th>Time</th></tr></thead><tbody><c:forEach var="t" items="${transactions}"><tr><td><strong>${t.description}</strong><small>${t.category}</small></td><td>${t.referenceNumber}</td><td>${t.type}</td><td class="${t.sourceAccount == account.accountNumber ? 'debit-text' : 'credit-text'}">${t.sourceAccount == account.accountNumber ? '-' : '+'}₹${t.amount}</td><td><span class="pill ${t.status == 'SUCCESS' ? 'success' : 'warning'}">${t.status}</span></td><td>${t.timestamp}</td></tr></c:forEach></tbody></table><c:if test="${empty transactions}"><div class="empty-state">No transactions matched those filters.</div></c:if></div></section><jsp:include page="includes/footer.jsp"/>
