<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Payments"/><c:set var="pageHeading" value="Everyday payments."/><c:set var="pageEyebrow" value="Bills, recharges & fees"/><c:set var="pageKey" value="payments"/><jsp:include page="includes/header.jsp"/>
<div class="service-grid"><a class="service-tile glass-panel" href="#bill-form" data-prefill="Electricity|Noida Power Company"><span class="service-icon">ϟ</span><strong>Electricity</strong><small>Pay your utility bill</small></a><a class="service-tile glass-panel" href="#bill-form" data-prefill="Mobile|Airtel Prepaid Recharge"><span class="service-icon">⌁</span><strong>Mobile recharge</strong><small>Recharge a prepaid number</small></a><a class="service-tile glass-panel" href="#bill-form" data-prefill="Education|Galgotias University"><span class="service-icon">⌘</span><strong>Education</strong><small>Fees & university payments</small></a><a class="service-tile glass-panel" href="#bill-form" data-prefill="Broadband|Airtel Xstream Fiber"><span class="service-icon">◉</span><strong>Broadband</strong><small>Keep your internet active</small></a></div>
<div class="split-layout"><section class="glass-panel content-card" id="bill-form"><div class="section-head"><div><span class="section-kicker">Payment centre</span><h2>Pay a bill or recharge</h2><p class="muted">Payments debit your simulated account and create a transaction + notification record.</p></div></div><form class="bank-form" method="post" action="${pageContext.request.contextPath}/payments" data-confirm="Confirm this payment?"><input type="hidden" name="csrfToken" value="${csrfToken}"><label>Category<select name="category" id="paymentCategory" required><option value="Utilities">Utilities</option><option value="Mobile">Mobile</option><option value="Education">Education</option><option value="Broadband">Broadband</option><option value="DTH">DTH</option><option value="Credit Card">Credit Card</option></select></label><label>Biller<input name="biller" id="paymentBiller" required placeholder="Biller or merchant"></label><label>Amount<input type="number" name="amount" min="1" step="0.01" required placeholder="0.00"></label><label>Due date <span class="muted">optional</span><input type="date" name="dueDate"></label><button class="primary-button full" type="submit">Pay securely <span>→</span></button></form></section><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Balance context</span><h2>Primary account</h2></div></div><div class="big-balance">₹${account.balance}</div><p class="muted">Available in ${account.maskedAccountNumber}</p><div class="split-note"><span>Tip</span><p>Use small demo amounts when testing so you can explore multiple transactions without exhausting the seeded balance.</p></div></section></div><jsp:include page="includes/footer.jsp"/>
