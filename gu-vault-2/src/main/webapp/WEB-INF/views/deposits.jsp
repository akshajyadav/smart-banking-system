<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Deposits"/><c:set var="pageHeading" value="Grow your balance."/><c:set var="pageEyebrow" value="Savings & deposits"/><c:set var="pageKey" value="deposits"/><jsp:include page="includes/header.jsp"/>
<div class="split-layout"><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Open deposit</span><h2>Build a fixed deposit</h2><p class="muted">The principal is debited from your simulated savings account and held until maturity.</p></div></div><form class="bank-form" method="post" action="${pageContext.request.contextPath}/deposits" data-confirm="Create this deposit?"><input type="hidden" name="csrfToken" value="${csrfToken}"><label>Deposit type<select name="depositType"><option>Fixed Deposit</option><option>Recurring Deposit</option></select></label><label>Amount<input type="number" name="amount" min="1000" step="500" value="10000" required></label><label>Interest rate (%)<input type="number" name="rate" min="1" max="15" step="0.01" value="7.10" required></label><label>Tenure (months)<input type="number" name="months" min="3" max="60" value="12" required></label><button class="primary-button full" type="submit">Open deposit <span>→</span></button></form></section><section class="glass-panel content-card"><div class="section-head"><div><span class="section-kicker">Active deposits</span><h2>Your savings</h2></div><div class="small-stat"><span>Available</span><strong>₹${account.balance}</strong></div></div><div class="deposit-list"><c:forEach var="d" items="${deposits}"><div class="deposit-row"><div class="quick-icon">◉</div><div class="grow"><strong>${d.depositType}</strong><small>₹${d.principal} · ${d.interestRate}% · ${d.tenureMonths} months</small></div><div><span class="pill success">${d.status}</span><small>Matures ${d.maturityDate}</small></div></div></c:forEach><c:if test="${empty deposits}"><div class="empty-state">No active deposits.</div></c:if></div></section></div><jsp:include page="includes/footer.jsp"/>
